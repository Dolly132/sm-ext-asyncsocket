import os

projectName = 'AsyncSocket'

project = builder.LibraryProject(projectName)
project.sources += [
  os.path.join(Extension.ext_root, 'src', 'extension.cpp'),
  os.path.join(Extension.ext_root, 'src', 'context.cpp'),
  os.path.join(Extension.sm_root, 'public', 'smsdk_ext.cpp'),
]

# Locate libuv root directory
libuv_root = os.path.join(Extension.ext_root, 'libuv')

# Fallback if artifact was extracted without the 'libuv' wrapper
if not os.path.exists(os.path.join(libuv_root, 'include')):
  libuv_root = Extension.ext_root

libuv_inc = os.path.join(libuv_root, 'include')

for sdk_name in Extension.sdks:
  sdk = Extension.sdks[sdk_name]
  if sdk['name'] in ['mock']:
    continue

  for cxx in builder.targets:
    if not cxx.target.arch in sdk['platforms'][cxx.target.platform]:
      continue

    binary = Extension.HL2ExtConfig(
        project, builder, cxx, projectName + '.ext', sdk
    )

    # Always add the main include folder where uv.h lives
    if os.path.exists(libuv_inc):
      binary.compiler.cxxincludes += [libuv_inc]

    if cxx.target.platform == 'windows':
      binary.compiler.linkflags += ['ws2_32.lib', 'iphlpapi.lib', 'userenv.lib', 'dbghelp.lib']
      
      # Link static libuv library on Windows MSVC
      libuv_win_lib = os.path.join(libuv_root, 'lib', 'libuv.lib')
      if not os.path.exists(libuv_win_lib):
        libuv_win_lib = os.path.join(libuv_root, 'Release', 'libuv.lib')
      
      if os.path.exists(libuv_win_lib):
        binary.compiler.linkflags += [libuv_win_lib]

    elif cxx.target.platform == 'linux':
      if cxx.target.arch == 'x86':
        libuv_linux_lib = os.path.join(libuv_root, 'lib', 'libuv.a')
        if not os.path.exists(libuv_linux_lib):
          libuv_linux_lib = os.path.join(libuv_root, '.libs', 'libuv.a')
        
        if os.path.exists(libuv_linux_lib):
          binary.compiler.linkflags += [libuv_linux_lib]
        else:
          binary.compiler.linkflags += ['-luv']

Extension.extensions += builder.Add(project)
